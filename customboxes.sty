\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{customboxes}[2026/05/20 Griffiths-style exercises for lecture notes]
\RequirePackage{tikz}
\usetikzlibrary{decorations.pathmorphing, patterns}
\RequirePackage{amsthm}
\RequirePackage{changepage}
\RequirePackage{marginnote}

\newlength{\exerciseindent}
\setlength{\exerciseindent}{1.5em}

\newtheoremstyle{griffiths}{0pt}{0pt}{}{0pt}{\bfseries}{}{0.5em}{}
\theoremstyle{griffiths}
\newtheorem{innerexercise}{Exercise}[section]

% --- Double rule: two full-width rules separated by exactly \exrulesep.
% \rule reliably spans \linewidth; setting \baselineskip to \exrulesep
% (locally, in a group) makes the gap between the two rule-lines exactly
% \exrulesep with no stray paragraph leading.
\newlength{\exrulesep}\setlength{\exrulesep}{1.2pt}
\newcommand{\exdoublerule}{%
  \par\nobreak
  \begingroup
    \lineskiplimit=-\maxdimen
    \baselineskip=\exrulesep
    \noindent\rule{\linewidth}{0.4pt}\par
    \noindent\rule{\linewidth}{0.4pt}\par
  \endgroup
}

\newenvironment{problem}[1][]{%
  \begin{innerexercise}[#1]%
}{%
  \end{innerexercise}%
  \par\addvspace{\medskipamount}%
}

\newenvironment{exerciseblock}{%
  \par\addvspace{\medskipamount}%
  \noindent
  \begin{minipage}{\linewidth}%
    \exdoublerule
    \par\addvspace{\smallskipamount}%
    \begin{adjustwidth}{\exerciseindent}{\exerciseindent}%
}{%
    \end{adjustwidth}%
    \par\addvspace{\smallskipamount}%
    \exdoublerule
  \end{minipage}%
  \par\addvspace{\medskipamount}%
}

\newenvironment{exercise}[1][]{%
  \exerciseblock
  \begin{innerexercise}[#1]%
}{%
  \end{innerexercise}%
  \endexerciseblock
}

\newcommand{\hard}{{\reversemarginpar\marginnote{\bfseries!}}}
\newcommand{\usedlater}{{\reversemarginpar\marginnote{\textbullet}}}
\newcommand{\answer}[1]{\medskip\noindent\textbf{Answer:} #1}

% -- Piano because I'm cute --
\newcommand{\pianomarker}{%
  \marginnote{%
    \begin{tikzpicture}[scale=0.14]
      \fill[rounded corners=2pt,gray!85!black] (-1,-1) rectangle (15,9);
      \fill[white] (0,0) rectangle (14,7);
      \foreach \x in {0,2,...,14} \draw[gray!60,thin] (\x,0) -- (\x,7);
      \foreach \x in {1.4,3.4,7.4,9.4,11.4}
        \fill[black] (\x,2.8) rectangle (\x+1.2,7);
    \end{tikzpicture}%
  }%
}

% -- Shallow water cartoon --
\newcommand{\shallowwatermarker}{%
  \marginnote{%
    \centering
    \begin{tikzpicture}[scale=0.14]
      \fill[blue!45]
        plot[domain=0:14,samples=80] (\x,{5.4+0.7*sin(\x*70)})
        -- (14,0) -- (0,0) -- cycle;
      \draw[blue!60!black,thick]
        plot[domain=0:14,samples=80] (\x,{5.4+0.7*sin(\x*70)});
      \draw[gray!70!black,thick] (0,8) -- (0,0) -- (14,0) -- (14,8);
      \draw[<->] (1.6,0) -- (1.6,4.9);
      \node[scale=0.9] at (3.0,2.4) {$h$};
      \draw[->,blue!60!black,thick] (5.4,6.7) -- (8.6,6.7);
      \node[scale=0.9,above] at (7.0,6.7) {$c$};
    \end{tikzpicture}\\[2pt]
    {\scriptsize$c=\sqrt{gh}=\lambda^{-1/2}$}%
  }%
}

% -- Coupled-oscillator schematic: one panel, both normal modes --
\newcommand{\springsmodes}{%
\begin{tikzpicture}[
  scale=0.42, transform shape,
  spring/.style={decorate, decoration={coil, aspect=0.6, segment length=0.75mm,
                 amplitude=1.6mm, pre length=2.5mm, post length=2.5mm}},
  wall/.style={pattern=north east lines, draw, line width=0.3pt},
  mass/.style={draw, thick, fill=blue!12, minimum width=8mm, minimum height=8mm}
]
  \def\wallh{0.85}
  \fill[wall] (-0.25,-\wallh) rectangle (0,\wallh);
  \draw[thick] (0,-\wallh) -- (0,\wallh);
  \fill[wall] (8.0,-\wallh) rectangle (8.25,\wallh);
  \draw[thick] (8.0,-\wallh) -- (8.0,\wallh);
  \node[mass] (m1) at (2.6,0) {};
  \node[mass] (m2) at (5.4,0) {};
  \draw[spring] (0,0) -- (m1.west);
  \draw[spring] (m1.east) -- (m2.west);
  \draw[spring] (m2.east) -- (8.0,0);
  \draw[->,very thick,red!70!black] (m1.north)++(0,0.4)--++(0.7,0);
  \draw[->,very thick,red!70!black] (m2.north)++(0,0.4)--++(0.7,0);
  \node[font=\footnotesize, red!70!black] at (4.0,1.45) {in-phase};
  \draw[->,very thick,blue!60!black] (m1.south)++(0,-0.4)--++(0.7,0);
  \draw[->,very thick,blue!60!black] (m2.south)++(0,-0.4)--++(-0.7,0);
  \node[font=\footnotesize, blue!60!black] at (4.0,-1.45) {out-of-phase};
\end{tikzpicture}}

